{
  "format": "dsh-moegirl/pack",
  "version": 1,
  "id": "amiya",
  "name": "阿米娅 Q 版",
  "frame": { "width": 384, "height": 704 },
  "atlas": { "src": "atlas.png", "count": 6 },
  "frames": {
    "idle": 0,
    "blink": 1,
    "working": 2,
    "attention": 3,
    "done": 4,
    "approval": 5
