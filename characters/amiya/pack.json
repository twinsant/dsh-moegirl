        { "at": 1, "translateY": 0 }
      ]
    },
    "hop": {
      "duration": 0.6,
      "easing": "ease-in-out",
      "track": [
        { "at": 0, "translateY": 0, "scale": 1 },
        { "at": 0.2, "translateY": 1, "scale": [1.03, 0.97] },
        { "at": 0.55, "translateY": -11, "scale": [0.99, 1.01] },
        { "at": 1, "translateY": 0, "scale": 1 }
      ]
    },
    "rejoice": {
      "duration": 1.1,
      "easing": "ease-in-out",
      "track": [
        { "at": 0, "translateY": 0, "rotate": 0 },
        { "at": 0.25, "translateY": -2, "scale": [1.04, 0.96] },
        { "at": 0.5, "translateY": -14, "rotate": -2 },
        { "at": 0.75, "translateY": 0, "scale": [1.03, 0.97] },
        { "at": 1, "translateY": 0, "rotate": 0, "scale": 1 }
