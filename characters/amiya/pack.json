  "states": {
    "idle": {
      "frame": "idle",
      "sequence": "blink",
      "motion": "breathe",
      "bubble": { "zh": "现在没有任务，歇一会儿～", "en": "No tasks right now, taking a break~" }
    },
    "working": {
      "frame": "working",
      "motion": "hop",
      "bubble": { "zh": "正在处理…", "en": "Working on it…" }
