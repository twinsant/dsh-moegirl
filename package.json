{
  "name": "dsh-moegirl",
  "description": "DeepSeek Harness 桌面精灵插件：Web UI 右下角的萌娘，实时反映 agent 运行状态",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "sync:paths": "node scripts/sync-paths.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/react": "~18.3.1",
    "lightningcss": "^1.27.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.8.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ]
}
